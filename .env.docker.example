# NovaOps 容器化启动的环境变量模板
#
# 用法：复制为仓库根目录的 .env，填入真实值后执行 `docker compose up -d`
#   PowerShell:  Copy-Item .env.docker.example .env
#   bash:        cp .env.docker.example .env
#
# .env 已被 .gitignore 忽略，且被 .dockerignore 排除，不会进入镜像或仓库。

# ---------- 数据库（容器内新建的 MySQL）----------
# MySQL root 密码；后端会以 root 连接同一实例
NOVAOPS_DB_PASSWORD=novaops

# ---------- 必填：JWT 签名密钥 ----------
# 至少 32 字节，缺失时 compose 会直接报错退出；请使用随机值，不要沿用示例
#   PowerShell: -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
#   bash:       openssl rand -hex 32
NOVAOPS_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# ---------- 可选：SiliconFlow（知识库向量化与 RAG 问答）----------
# 留空时服务仍可启动，但文档向量化与 RAG 问答不可用
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
SILICONFLOW_CHAT_MODEL=Qwen/Qwen3-8B
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_COLLECTION=novaops_kb
NOVAOPS_AGENT_PLAN_ENABLED=true

# ---------- 可选：本地落盘上限 ----------
# 知识库与工单附件都存在独立数据卷里（novaops-kb-data / novaops-attachment-data）
# 工单附件默认上限 20MB，可按需调整
NOVAOPS_TICKET_MAX_FILE_BYTES=20971520

# ---------- 可选：MCP Server（对暴露只读工具，留空 = 禁用）----------
NOVAOPS_AGENT_MCP_SERVER_TOKEN=

# ---------- 可选：邮件（log = 不真正发信，注册激活链接写入日志）----------
MAIL_MODE=log
MAIL_ACTIVATION_BASE_URL=http://localhost:8088

# ---------- 宿主机端口映射（仅绑定 127.0.0.1）----------
# 若与本机已有服务冲突，改这里即可
WEB_HOST_PORT=8088
BACKEND_HOST_PORT=8090
MYSQL_HOST_PORT=13306
